    },
    {
      "parameters": {
        "jsCode": "// Check if organic_results is defined\nif ($json.organic_results) {\n  // Extract positions 1 to 3 (index 0 to 2) from organic_results\n  const filteredOrganicResults = $json.organic_results.slice(0, 2);\n\n  return {\n    json: {\n      filtered_organic_results: filteredOrganicResults\n    }\n  };\n} else {\n  // Return an empty array if 'organic_results' is not available\n  return {\n    json: {\n      filtered_organic_results: []\n    }\n  };\n}"
      },
