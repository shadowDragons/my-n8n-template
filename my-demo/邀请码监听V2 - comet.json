    {
      "parameters": {
        "jsCode": "// Assuming list1 and list2 are correctly populated\nconst list1 = $('Remove Duplicates').all();\nconst list2 = $('Filter').all();\n\nconst result = [];\n\n// Use map() to extract all targetUrls from list2 and join them into a single string\nconst targetUrlsString = list2.map(item => item.json.target_url).join('<br/>');\n\n// If both lists exist and have items, proceed with the loop\nif (list1 && list1.length > 0) {\n  for (const item1 of list1) {\n    // Create a copy of the current item's JSON\n    const resultItem = { ...item1.json };\n    \n    // Assign the combined targetUrl string to the new object\n    resultItem.targetUrl = targetUrlsString;\n    \n    // Push the new object into the result array\n    result.push(resultItem);\n  }\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2736,
        -64
      ],
      "id": "71d991c0-01d7-427c-979f-23135d7fcb98",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $(\"Merge1\").all();\n\nconst urlRegex = /https?:\\/\\/[^\\s\"'<>()]+/g;\n\nlet urls = [];\nfor (const item of allItems) {\n  // 使用正则表达式查找所有链接\n  let match;\n  while ((match = urlRegex.exec(item.json.content)) !== null) {\n    urls.push(match[0]);\n  }\n}\n\nreturn {\n  urls: urls\n};"
      },
