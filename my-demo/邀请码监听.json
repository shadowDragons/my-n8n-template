    {
      "parameters": {
        "jsCode": "const list1 = $('Execute a SQL query').all();\nconst list2 = $('Code1').all();\nconst result = [];\n\nif (list1 && list2) {\n  for (const item1 of list1) {\n    for (const item2 of list2) {\n      // 使用扩展运算符 (...) 创建一个新对象，复制 item2 的所有属性\n      const resultItem = { ...item2.json };\n      \n      // 添加来自 item1 的 email 属性\n      resultItem.email = item1.json.email;\n\n      // 将新对象推入结果数组\n      result.push(resultItem);\n    }\n  }\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        32
      ],
      "id": "d244afb3-a890-4e1c-a7cc-d5aac2394810",
      "name": "Code"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 从 n8n 输入中获取文本数据\n// 假设您的文本位于 item.json.text 字段中\nconst text = $json.content\n\n// 定义用于匹配链接的正则表达式\n// 这个正则表达式会匹配以 \"http\" 或 \"https\" 开头的所有 URL\nconst urlRegex = /(https?:\\/\\/[^\\s]+)/g;\n\n// 定义用于模糊匹配目标链接的正则表达式\n// 这个表达式匹配包含 \"perplexity.ai/browser/claim\" 的链接\nconst targetRegex = /perplexity\\.ai\\/browser\\/claim/i;\n\n// 存储匹配到的所有链接和目标链接\nconst allLinks = [];\nconst matchingLinks = [];\n\n// 使用正则表达式查找所有链接\nlet match;\nwhile ((match = urlRegex.exec(text)) !== null) {\n  const link = match[0];\n  allLinks.push(link);\n\n  // 检查当前链接是否模糊匹配目标链接\n  if (targetRegex.test(link)) {\n    matchingLinks.push(link);\n  }\n}\n\n// 将结果输出到 n8n\n// 您可以根据需要调整输出的格式\nreturn {\n  link: $json.link,\n  title: $json.title,\n  content: $json.content,\n  urls: {\n    allLinks: allLinks,\n    matchingLinks: matchingLinks\n  }\n};"
      },
