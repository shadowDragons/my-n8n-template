    {
      "parameters": {
        "jsCode": "// Assuming list1 and list2 are correctly populated\nconst list1 = $('Execute a SQL query').all();\nconst list2 = $('Loop Over Items1').all();\n\nconst result = [];\n\n// Use map() to extract all targetUrls from list2 and join them into a single string\nconst targetUrlsString = list2.map(item => item.json.target_url).join('<br/>');\n\n// If both lists exist and have items, proceed with the loop\nif (list1 && list1.length > 0) {\n  for (const item1 of list1) {\n    // Create a copy of the current item's JSON\n    const resultItem = { ...item1.json };\n    \n    // Assign the combined targetUrl string to the new object\n    resultItem.targetUrl = targetUrlsString;\n    \n    // Push the new object into the result array\n    result.push(resultItem);\n  }\n}\n\nreturn result;"
      },
