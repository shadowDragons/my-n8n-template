    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nconst urlRegex = /https?:\\/\\/[^\\s\"'<>()]+/g;\n\nlet urls = [];\nfor (const item of allItems) {\n  // 使用正则表达式查找所有链接\n  let match;\n  while ((match = urlRegex.exec(item.json.content)) !== null) {\n    urls.push(match[0]);\n  }\n}\n\nreturn {\n  urls: urls\n};"
      },
