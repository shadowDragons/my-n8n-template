      "parameters": {
        "jsCode": "\n// 标题/正文/封面ID等基础信息\nconst title    =  $('AI Agent').first().json.output.title  || '';\nconst content  =  $('AI Agent1').first().json.output.article || '';\nconst digest   =  $('AI Agent').first().json.output.digest || ''; // 可选摘要\nconst author   = 'A流派';\nconst thumb_media_id = $input.first().json.media_id || '';\nconst content_source_url = ''; // 原文链接（选填）\n// 可选：封面裁剪\nconst pic_crop_235_1 = ''; // 如'0.1945_0_1_0.5236'\nconst pic_crop_1_1   = '';\n// 构建articles对象（标准图文，article_type默认为news）\nconst articles = [\n  {\n    article_type: 'news',\n    title,\n    author,\n    digest,                 // 为空时微信自动截取正文前54字\n    content,                // 支持HTML\n    content_source_url,     // 原文链接\n    thumb_media_id,\n    need_open_comment: 0,\n    only_fans_can_comment: 0,\n    pic_crop_235_1,\n    pic_crop_1_1,\n    // 如需添加更多参数，可按需补充\n  }\n];\n// 如果你还需要组图片消息或商品，可在此扩展articles.push({...})\n// 返回对象+字符串两种格式\nreturn [\n  {\n    json: {\n      articles,\n      articlesJson: JSON.stringify(articles)\n    }\n  }\n];"
